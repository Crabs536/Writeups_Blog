digraph G {
  graph [rankdir=TB, bgcolor="white", pad=0.28, nodesep=0.34, ranksep=0.52, splines=ortho, fontname="DejaVu Sans"];
  node [shape=box, style="rounded,filled", fillcolor="#F0F6FA", color="#A7C2D6", fontname="DejaVu Sans", fontsize=11, margin="0.16,0.12"];
  edge [color="#607D8B", penwidth=1.5, arrowsize=0.65];
  A [label="Misconfigured ACL\nGenericWrite on account"];
  B [label="AD account attribute\nmsDS-KeyCredentialLink"];
  C [label="Kerberos PKINIT\nkey-based authentication"];
  D [label="KDC validates key\nTGT is issued"];
